# INEXION Registry — Streamlit Cloud Secrets Template
# Copy this structure into the Streamlit Cloud dashboard under Settings → Secrets.
# Do NOT commit the actual secrets.toml file — keep this template only.

# --- Data location ---
# Production tree layout (per Registry Schema v0.3). Paths are constructed
# in src/config.py from this bucket root plus per-source prefixes
# (bronze/public/..., bronze/restricted/..., derived/...).
INEXION_BUCKET_ROOT = "s3://inexion-registry"

# Legacy flat fallback (only used if INEXION_BUCKET_ROOT is unset).
# Kept here for reference / rollback during the transition window.
# INEXION_DATA_DIR = "s3://inexion-registry/temp_Ian_Nirav/staging"

# --- AWS credentials ---
# Read-only IAM user for Streamlit Cloud access. The user needs s3:GetObject
# and s3:ListBucket on the inexion-registry bucket.
AWS_ACCESS_KEY_ID     = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
AWS_DEFAULT_REGION    = "us-east-2"

# --- Claude API (for PDF lab report extraction) ---
ANTHROPIC_API_KEY = "sk-ant-..."
